{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TalentScoutCandidateResumeSchema",
  "description": "JSON Schema for candidate CV profile extraction in TalentScout AI ATS with evidence-backed skills",
  "type": "object",
  "required": [
    "contact_info",
    "work_experience",
    "education",
    "skills",
    "metadata"
  ],
  "properties": {
    "contact_info": {
      "type": "object",
      "properties": {
        "full_name": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"], "format": "email" },
        "phone": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] },
        "linkedin_url": { "type": ["string", "null"] },
        "portfolio_url": { "type": ["string", "null"] },
        "github_url": { "type": ["string", "null"] }
      },
      "required": ["full_name", "email"]
    },
    "summary": { "type": ["string", "null"] },
    "total_experience_years": { "type": ["number", "null"], "minimum": 0 },
    "work_experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["company", "title"],
        "properties": {
          "company": { "type": "string" },
          "title": { "type": "string" },
          "location": { "type": ["string", "null"] },
          "start_date": { "type": ["string", "null"] },
          "end_date": { "type": ["string", "null"] },
          "is_current": { "type": "boolean", "default": false },
          "description": { "type": ["string", "null"] },
          "skills": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["institution"],
        "properties": {
          "institution": { "type": "string" },
          "degree": { "type": ["string", "null"] },
          "field_of_study": { "type": ["string", "null"] },
          "start_year": { "type": ["integer", "null"] },
          "end_year": { "type": ["integer", "null"] },
          "gpa": { "type": ["string", "null"] }
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "Extracted candidate skills with strict confidence score and evidence citation",
      "items": {
        "type": "object",
        "required": ["name", "confidence", "evidence"],
        "properties": {
          "name": { "type": "string" },
          "category": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "evidence": { "type": "string", "description": "Exact excerpt from CV proving the skill" }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "issuer": { "type": ["string", "null"] },
          "year": { "type": ["integer", "null"] }
        }
      },
      "default": []
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["language"],
        "properties": {
          "language": { "type": "string" },
          "proficiency": { "type": ["string", "null"] }
        }
      },
      "default": []
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] },
          "technologies": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "url": { "type": ["string", "null"] }
        }
      },
      "default": []
    },
    "metadata": {
      "type": "object",
      "required": ["parsed_at", "parser_version", "file_type"],
      "properties": {
        "parsed_at": { "type": "string" },
        "parser_version": { "type": "string" },
        "file_type": { "type": "string" },
        "language_detected": { "type": "string", "enum": ["vi", "en", "unknown"], "default": "unknown" },
        "raw_character_count": { "type": "integer" }
      }
    }
  }
}

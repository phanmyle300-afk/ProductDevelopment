# ==============================================================================
# TalentScout AI ATS — Environment Configuration Template (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép tệp này thành .env:
#    cp .env.example .env (hoặc copy .env.example .env trên Windows)
# 2. Điền các giá trị thực tế theo nhu cầu môi trường của bạn.
# 3. TUYỆT ĐỐI KHÔNG commit tệp .env chứa secret hoặc API keys lên GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & FastAPI Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
APP_NAME="TalentScout AI ATS"
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. Database & Vector Storage (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=talentscout_user
POSTGRES_PASSWORD=talentscout_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=talentscout_ats
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. Redis & Celery Background Workers
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 4. S3-Compatible Object Storage (MinIO / AWS S3)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=talentscout-resumes
S3_REGION=us-east-1
S3_SECURE=False

# ------------------------------------------------------------------------------
# 5. Frontend Settings (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 6. LLM Providers (Theo Thứ Tự Ưu Tiên Fallback)
# ------------------------------------------------------------------------------
# Tầng 1: Google Gemini (Ưu tiên chính - Gemini 1.5 Flash)
# Lấy API key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Tầng 2: OpenAI (Dự phòng Cloud - GPT-4o-mini & Embeddings)
# Lấy API key tại: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Tầng 3: Ollama (Dự phòng Offline / Local host)
# Cài đặt Ollama từ: https://ollama.ai/ và kéo mô hình: ollama pull llama3:70b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:70b

# ------------------------------------------------------------------------------
# 4. Vector Embedding Model
# ------------------------------------------------------------------------------
# Tùy chọn: "local" (sử dụng HuggingFace BAAI/bge-m3) hoặc "openai" (text-embedding-3-small)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# 5. Ingest & OCR Engine (PyMuPDF & Tesseract)
# ------------------------------------------------------------------------------
# Đường dẫn tesseract executable nếu không nằm trong PATH hệ thống (Windows)
# Ví dụ: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
TESSERACT_LANG=vie+eng

# ------------------------------------------------------------------------------
# 6. Auto-Outreach Email Providers (Theo Thứ Tự Ưu Tiên)
# ------------------------------------------------------------------------------
# Chế độ gửi email: "preview" (mặc định an toàn cho test), "sendgrid", hoặc "smtp"
EMAIL_PROVIDER=preview
EMAIL_FROM_ADDRESS=recruitment@talentscout.ai
EMAIL_FROM_NAME="TalentScout Hiring Team"

# Tầng 1: SendGrid API
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Tầng 2: SMTP Server (Gmail / Internal Mail Server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_USE_TLS=True

# Tầng 3: Thư mục lưu bản nháp xem trước cục bộ (Local Preview Mode)
LOCAL_EMAIL_PREVIEW_DIR=data/outbox/

# ------------------------------------------------------------------------------
# 7. ATS Business Rules & Compliance
# ------------------------------------------------------------------------------
# Tự động ẩn danh hóa PII (Blind Screening) trước khi chuyển sang Tech Lead
BLIND_SCREENING_DEFAULT=True

# Trọng số thành phần Hybrid Match (Tổng = 1.0)
WEIGHT_SKILLS=0.40
WEIGHT_EXPERIENCE=0.25
WEIGHT_EDUCATION=0.15
WEIGHT_SEMANTIC=0.20

# Hình phạt trừ phần trăm điểm nếu thiếu mandatory skills (0.25 = trừ 25%)
MANDATORY_SKILL_PENALTY_RATE=0.25

# Ngưỡng kiểm định Four-Fifths Rule (0.80 = 80%)
EEOC_FOUR_FIFTHS_THRESHOLD=0.80
